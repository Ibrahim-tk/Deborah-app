      "kind": "profileFor",
      "title": "Who is this profile for?"
    },
    {
      "key": "relationship",
      "kind": "choice",
      "title": "Who are they to you?",
      "showIf": {
        "profileFor": { "in": ["dependent"] }
      },
      "choices": [
        { "value": "daughter", "label": "Daughter" },
        { "value": "son", "label": "Son" },
        { "value": "partner", "label": "Partner" },
        { "value": "parent", "label": "Parent" },
        { "value": "other", "label": "Someone else" }
      ]
    },
    {
      "key": "memberName",
      "kind": "name",
      "title": "What’s their first name?",
      "placeholder": "First name",
      "showIf": {
        "profileFor": { "in": ["dependent"] }
      }
    },
